rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 랭킹 (2D: scores, 3D: scores3d): 누구나 읽기, 새 기록 추가만 가능 (수정, 삭제 불가)
    match /{coll}/{id} {
      allow read: if coll == 'scores' || coll == 'scores3d';
      allow create: if (coll == 'scores' || coll == 'scores3d')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 10
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 9999
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
